{
  "name": "learning-to-py-server",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node seeders/seedDatabase.js",
    "seed:dry-run": "SEED_DRY_RUN=true node seeders/seedDatabase.js",
    "seed:modules": "SEED_MODULES=1-5 node seeders/seedDatabase.js",
    "seed:safe": "SEED_CLEAR_DATA=false node seeders/seedDatabase.js",
    "update": "node seeders/updateCurriculum.js",
    "update:verify": "node seeders/updateCurriculum.js --verify",
    "update:list": "node seeders/updateCurriculum.js --list",
    "reset:users": "node seeders/resetUserData.js",
    "reset:lesson": "node scripts/resetUserLesson.js",
    "reset:curriculum": "SEED_CLEAR_DATA=true node seeders/seedDatabase.js",
    "backup:db": "node scripts/backupDatabase.js",
    "restore:db": "node scripts/restoreDatabase.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
